					"name": "List Tasks (Filtered)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/tasks?project_id={{projectId}}&status=todo",
							"host": ["{{baseUrl}}"],
							"path": ["api", "tasks"],
							"query": [
								{
									"key": "project_id",
									"value": "{{projectId}}"
								},
								{
									"key": "status",
									"value": "todo"
								}
							]
						}
					}
				},
				{
					"name": "Create Task",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
